# Android Keystore Configuration
# Copy this file to 'key.properties' in the project root and fill in your values
# DO NOT commit key.properties to git (already in .gitignore)

# Path to your keystore file (relative to project root)
storeFile=../freq.jks

# Keystore password
storePassword=YOUR_KEYSTORE_PASSWORD

# Key alias name
keyAlias=YOUR_KEY_ALIAS

# Key password (usually same as storePassword)
keyPassword=YOUR_KEY_PASSWORD





